{
    "name": "blank-project",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "vercel": "next build",
        "start": "next start",
        "lint": "eslint",
        "next:update": "bun add next@latest react@latest react-dom@latest eslint-config-next@latest",
        "commit": "git pull && bun update && bun getSecurity.ts && bun run vercel && read -p 'Descriptions\n Commit: ' message && git add . && echo -n \"$message - \" && node getTime.js | xargs -I {} git commit -m \"$message - {}\" && git push",
        "clean": "rm -rf node_modules && bun install"
    },
    "dependencies": {
        "lucide-react": "^1.38.0",
        "next": "^16.3.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sonner": "^2.0.8",
        "styled-components": "^6.5.3",
        "supabase": "^2.116.0"
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "eslint": "^10.9.1",
        "eslint-config-next": "^16.3.3",
        "typescript": "^7.0.2"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}